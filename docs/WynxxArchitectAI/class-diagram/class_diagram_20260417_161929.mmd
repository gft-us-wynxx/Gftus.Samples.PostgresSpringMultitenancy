    %% All relationships outside namespace blocks
    Instantiation --|> CommandLineRunner : implements
    Instantiation --> AuthorRepository : depends on
    Instantiation --> PostRepository : depends on

    TenantRoutingDataSource --|> AbstractRoutingDataSource : extends

    DataSourceConfiguration --> DataSourceProperties : dependency
    DataSourceConfiguration --> TenantRoutingDataSource : creates
    DataSourceConfiguration --> Flyway : uses

    HeaderTenantInterceptor --|> WebRequestInterceptor : implements
    HeaderTenantInterceptor --> ThreadTenantStorage : uses

    WebConfiguration --|> WebMvcConfigurer : implements
    WebConfiguration --> HeaderTenantInterceptor : dependency

    AuthorRepository --|> JpaRepository : extends
    PostRepository --|> JpaRepository : extends

    Author --|> Serializable : implements
    Post --|> Serializable : implements
    Author "1" --> "*" Post : OneToMany
    Post "*" --> "1" Author : ManyToOne

    PostResource --> PostService : uses
    PostResource --> Post : manages

    AuthorResource --> AuthorService : uses
    AuthorResource --> Author : manages
    AuthorResource --> Post : manages

    ResourceExceptionHandler --> StandardError : returns
    StandardError --|> Serializable : implements

    PostService --> PostRepository : uses
    PostService --> Post : manages

    AuthorService --> AuthorRepository : uses
    AuthorService --> Author : manages

    ObjectNotFoundException --|> RuntimeException : extends

    PostRepository --> Post : manages
    AuthorRepository --> Author : manages
