    namespace br_com_fullcustom_postgresmultitenancy_config {
        class Instantiation {
            -userRepository: AuthorRepository
            -postRepository: PostRepository
            +run(String[] args) void
        }
    }

    namespace br_com_fullcustom_postgresmultitenancy_config_datasource {
        class TenantRoutingDataSource {
            #determineCurrentLookupKey() Object
        }

        class DataSourceConfiguration {
            -dataSourceProperties: DataSourceProperties
            +DataSourceConfiguration(DataSourceProperties)
            +dataSource() DataSource
            +migrate() void
            -migrateDataSource(DataSource) void
        }

        class DataSourceProperties {
            -datasources: Map~Object, Object~
            +getDatasources() Map~Object, Object~
            +setDatasources(Map~String, Map~String, String~~) void
            +convert(Map~String, String~) DataSource
        }
    }

    namespace br_com_fullcustom_postgresmultitenancy_config_web {
        class HeaderTenantInterceptor {
            +TENANTHEADER: String$
            +preHandle(WebRequest) void
            +postHandle(WebRequest, ModelMap) void
            +afterCompletion(WebRequest, Exception) void
        }

        class WebConfiguration {
            -headerTenantInterceptor: HeaderTenantInterceptor
            +WebConfiguration(HeaderTenantInterceptor)
            +addInterceptors(InterceptorRegistry) void
        }

        class ThreadTenantStorage {
            -currentTenant: ThreadLocal~String~$
            +setTenantId(String) void$
            +getTenantId() String$
            +clear() void$
        }
    }

