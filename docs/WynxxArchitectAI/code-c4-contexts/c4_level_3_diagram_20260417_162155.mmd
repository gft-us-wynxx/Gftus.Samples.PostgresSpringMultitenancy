C4Component
    title Component diagram for PostgreSQL Multitenancy System

    Container_Boundary(api, "API Application") {
        Component(demoApp, "DemoApplication", "Spring Boot", "Spring Boot application entry point for PostgreSQL multitenancy system")
        Component(instantiation, "Instantiation", "Spring Boot CommandLineRunner", "Initialize and seed database with sample Author and Post data")
        Component(dataSourceConfig, "DataSourceConfiguration", "Spring Configuration", "Configures and manages multitenant data source routing with Flyway support")
        Component(dataSourceProps, "DataSourceProperties", "Spring ConfigurationProperties", "Manages multitenant datasource configuration properties")
        Component(tenantRoutingDS, "TenantRoutingDataSource", "Spring AbstractRoutingDataSource", "Routes database connections to tenant-specific data sources")
        Component(threadTenantStorage, "ThreadTenantStorage", "ThreadLocal Storage", "Stores and provides current tenant context for thread-safe tenant identification")
        Component(headerTenantInterceptor, "HeaderTenantInterceptor", "Spring Web Request Interceptor", "Intercepts HTTP requests to extract tenant identification from headers")
        Component(webConfig, "WebConfiguration", "Spring WebMvcConfigurer", "Configure web request interceptors for multitenancy header processing")
        Component(authorRepo, "AuthorRepository", "Spring Data JPA", "Data access layer for Author entities")
        Component(postRepo, "PostRepository", "Spring Data JPA", "Data access layer for Post entities")
        Component(authorEntity, "Author Entity", "JPA/Hibernate", "Domain entity representing an Author")
        Component(postEntity, "Post Entity", "JPA/Hibernate", "Entity representing a blog post")
        Component(authorResource, "Author Resource", "Spring Web REST Controller", "REST API endpoint controller for managing Author entities")
        Component(postResource, "Post Resource", "Spring Web REST Controller", "REST API endpoint controller for managing Post entities")
        Component(authorService, "Author Service", "Spring Service", "Business logic layer for Author entity operations")
        Component(postService, "Post Service", "Spring Service", "Business logic layer for Post entity operations")
        Component(resourceExceptionHandler, "Resource Exception Handler", "Spring Exception Handler", "Global exception handling for REST API endpoints")
        Component(objectNotFound, "ObjectNotFoundException", "Java Exception", "Custom exception class for handling object not found scenarios")
        Component(standardError, "StandardError", "Java", "Standardized error response object for REST API exception handling")
        Component(jacksonProcessor, "Jackson JSON Processor", "Jackson Library", "Serialization and deserialization of entities to/from JSON")
        Component(urlUtil, "URL", "Java Utility", "Utility class for URL parameter decoding and date string conversion")
    }

    ContainerDb(database, "PostgreSQL Database", "PostgreSQL", "Persistent data storage for Author and Post entities with multitenant schema isolation")

    Rel(demoApp, dataSourceConfig, "Uses", "Spring Autoconfiguration")
    Rel(demoApp, instantiation, "Initializes", "Spring Boot Lifecycle")
    Rel(instantiation, authorRepo, "Uses", "Spring Data JPA")
    Rel(instantiation, postRepo, "Uses", "Spring Data JPA")
    Rel(dataSourceConfig, dataSourceProps, "Depends on", "Spring Dependency Injection")
    Rel(dataSourceConfig, tenantRoutingDS, "Creates", "Spring Bean Factory")
    Rel(dataSourceConfig, jacksonProcessor, "Uses", "Flyway Migration")
    Rel(dataSourceProps, tenantRoutingDS, "Configures", "Spring DataSource Builder")
    Rel(tenantRoutingDS, threadTenantStorage, "Depends on", "ThreadLocal")
    Rel(headerTenantInterceptor, threadTenantStorage, "Uses", "Java dependency")
    Rel(headerTenantInterceptor, webConfig, "Registered by", "Spring MVC configuration")
    Rel(webConfig, headerTenantInterceptor, "Registers", "Spring MVC interceptor registry")
    Rel(threadTenantStorage, authorRepo, "Provides context to", "Tenant context injection")
    Rel(threadTenantStorage, postRepo, "Provides context to", "Tenant context injection")
    Rel(authorRepo, threadTenantStorage, "Uses context", "Tenant context retrieval")
    Rel(postRepo, threadTenantStorage, "Uses context", "Tenant context retrieval")
    Rel(authorResource, authorService, "Delegates to", "Spring Dependency Injection")
    Rel(authorResource, authorEntity, "Uses", "Domain Model")
    Rel(authorResource, jacksonProcessor, "Uses", "Jackson ObjectMapper")
    Rel(postResource, postService, "Delegates to", "Spring Dependency Injection")
    Rel(postResource, postEntity, "Uses", "Domain Model")
    Rel(postResource, jacksonProcessor, "Uses", "Jackson ObjectMapper")
    Rel(authorService, authorEntity, "Manages", "JPA Repository")
    Rel(authorService, postEntity, "Manages", "JPA Repository")
    Rel(authorService, database, "Persists to", "JDBC/JPA")
    Rel(postService, postEntity, "Manages", "JPA Repository")
    Rel(postService, authorEntity, "References", "JPA Repository")
    Rel(postService, database, "Persists to", "JDBC/JPA")
    Rel(authorEntity, postEntity, "One-to-Many", "JPA Cascade ALL")
    Rel(postEntity, authorEntity, "Many-to-One", "JPA Foreign Key")
    Rel(resourceExceptionHandler, authorResource, "Handles exceptions from", "Spring ControllerAdvice")
    Rel(resourceExceptionHandler, postResource, "Handles exceptions from", "Spring ControllerAdvice")
    Rel(authorService, objectNotFound, "Throws", "Exception Handling")
    Rel(postService, objectNotFound, "Throws", "Exception Handling")
    Rel(resourceExceptionHandler, objectNotFound, "Catches", "Spring Framework")
    Rel(objectNotFound, standardError, "Converts to", "HTTP Response")
    Rel(urlUtil, authorResource, "Provides utility functions to", "Java")
    Rel(urlUtil, postResource, "Provides utility functions to", "Java")

